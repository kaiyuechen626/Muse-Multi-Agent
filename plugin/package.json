  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "autostart.mjs",
    "scope-adapter.mjs",
    "connection.mjs",
    "bridge.mjs",
    "wallpaper-tools.mjs",
    "wallpaper-client-hook.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "licenses/",
    "native-chat.mjs"
  ],
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
